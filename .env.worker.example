# Скопировать в .env.worker на ВТОРОМ сервере (80.78.244.91).
# Значения DATABASE / AWS / KAFKA — те же, что в прод .env.
# Файл секретов: не коммитить.

# --- та же БД, что прод ---
DATABASE_URL=postgresql+psycopg://USER:PASS@rc1b-XXXX.mdb.yandexcloud.net:6432/DB
DATABASE_SSLMODE=require

# --- тот же Object Storage ---
AWS_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_KEY_ID=
AWS_SECRET_KEY=
AWS_BUCKET=explain-npa

# --- тот же Kafka (сводки LLM) ---
KAFKA_BOOTSTRAP_SERVERS=rc1a-XXXX.mdb.yandexcloud.net:9091
KAFKA_USERNAME=llm
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_PIPELINE_EVENTS=false
LLM_TRANSPORT=kafka
KAFKA_LLM_REQUESTS_TOPIC=llm.requests
KAFKA_LLM_RESPONSES_TOPIC=llm.responses
KAFKA_LLM_GROUP_ID=explainlaw-llm-worker
LLM_REQUEST_TIMEOUT=300
QWEN_MODEL=qwen3:8b

OCR_ENABLED=true
OCR_ENGINE=tesseract
OCR_TEXT_THRESHOLD=200
GATE_LLM_VERIFY=true

PRAVO_API_BASE_URL=http://publication.pravo.gov.ru
PRAVO_COLLECT_BLOCKS=president|president|government
PRAVO_COLLECT_TYPES=Федеральный закон|Указ|Постановление

# Worker loop (entrypoint); шарды 0/1 — в docker-compose.worker.yml
WORKER_PROCESS_LIMIT=100
WORKER_LOOP_SLEEP=15

# Не слать в Telegram с этого хоста
TELEGRAM_PUBLISH=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TZ=Europe/Moscow
