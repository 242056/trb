# === Локально (docker-compose) ===
DATABASE_URL=postgresql+psycopg://explainlaw:explainlaw@localhost:5432/explainlaw
DATABASE_SSLMODE=prefer

# --- Object storage: локальный MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=explainlaw
MINIO_SECRET_KEY=explainlawsecret
MINIO_BUCKET_RAW=npa-raw
MINIO_BUCKET_SNAPSHOTS=npa-snapshots
MINIO_SECURE=false
MINIO_REGION=
MINIO_PREFIX=

# --- Или Yandex Object Storage (S3) — перекрывает MINIO_* выше ---
# AWS_ENDPOINT_URL=https://storage.yandexcloud.net
# AWS_KEY_ID=
# AWS_SECRET_KEY=
# AWS_BUCKET=explain-npa
# (один бакет: PDF/ZIP и HTML-снимки рядом, разные расширения)

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_PIPELINE_EVENTS=true

# === Yandex Cloud (прод) — раскомментировать и заполнить ===
# DATABASE_URL=postgresql+psycopg://USER:PASS@rc1b-XXXX.mdb.yandexcloud.net:6432/regulatory-legal-acts
# DATABASE_SSLMODE=require
#
# KAFKA_BOOTSTRAP_SERVERS=rc1a-XXXX.mdb.yandexcloud.net:9091
# KAFKA_USERNAME=llm
# KAFKA_PASSWORD=
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SSL_CA_LOCATION=/path/to/YandexInternalRootCA.crt
# # На Yandex с ACL только llm.* — отключить pipeline-события:
# KAFKA_PIPELINE_EVENTS=false
# LLM_TRANSPORT=kafka
# KAFKA_LLM_REQUESTS_TOPIC=llm.requests
# KAFKA_LLM_RESPONSES_TOPIC=llm.responses
# KAFKA_LLM_GROUP_ID=explainlaw-llm
# LLM_REQUEST_TIMEOUT=300

# LLM: http (прямой OpenAI-совместимый) | kafka (Qwen worker)
LLM_TRANSPORT=http
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen3-8b

GATEWAY_API_BASE=
GATEWAY_API_KEY=
GATEWAY_MODEL=gpt-4o-mini

# OCR: публичного SberOCR API нет. Engines: paddle | tesseract | yandex
OCR_ENABLED=false
OCR_ENGINE=paddle
OCR_TEXT_THRESHOLD=200
YANDEX_VISION_API_KEY=
YANDEX_VISION_IAM_TOKEN=

# Публикация / алерты (§7, §11)
DIGEST_MIN_ITEMS=3
DIGEST_MAX_ITEMS=7
POST_RESERVE_COUNT=2
PUBLISH_EXPORT_DIR=logs/published
COLLECT_SILENT_ALERT_HOURS=36
ALERT_WEBHOOK_URL=
ALERT_LOG_PATH=logs/alerts.jsonl
# Telegram: группа/чат (отрицательный id для супергрупп)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Слать дайджест в группу при weekly publish / publish --mark-published
TELEGRAM_PUBLISH=true

# Гейты: LLM second-look / semantic после механики (§9)
GATE_LLM_VERIFY=true

# === Pipeline / парсинг (лимиты daily и backfill) ===
# Пусто = без лимита на process/gate
PIPELINE_PROCESS_LIMIT=
PIPELINE_FETCH_MISSING_LIMIT=3
PIPELINE_BACKFILL_LIMIT=500
PIPELINE_BACKFILL_PDF_LIMIT=
PIPELINE_SMOKE_PROCESS_LIMIT=5
COLLECT_PERIOD_TYPE=daily

# === Cron (Docker supercronic; TZ = Europe/Moscow по умолчанию) ===
TZ=Europe/Moscow
CRON_TIMEZONE=Europe/Moscow
CRON_DAILY_ENABLED=true
CRON_DAILY_SCHEDULE=0 8 * * *
CRON_WEEKLY_ENABLED=true
CRON_WEEKLY_SCHEDULE=0 9 * * 1
CRON_BACKFILL_ENABLED=true
CRON_BACKFILL_SCHEDULE=0 3 * * 0
CRON_HEALTH_ENABLED=true
CRON_HEALTH_SCHEDULE=30 */6 * * *
# Прод-тест: при старте cron сразу прогнать job, потом обычное расписание
# CRON_RUN_ON_START=true
# CRON_RUN_ON_START_JOB=weekly
# daily | weekly | health | smoke

PRAVO_API_BASE_URL=http://publication.pravo.gov.ru
PRAVO_BLOCK_PRESIDENT=president
PRAVO_DOCUMENT_TYPE_FZ_ID=82a8bf1c-3bc7-47ed-827f-7affd43a7f27
PRAVO_CATALOG_FZ_TOTAL=7761
