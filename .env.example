# PostgreSQL
DATABASE_URL=postgresql+psycopg://explainlaw:explainlaw@localhost:5432/explainlaw

# MinIO (объектное хранилище сырья)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=explainlaw
MINIO_SECRET_KEY=explainlawsecret
MINIO_BUCKET_RAW=npa-raw
MINIO_BUCKET_SNAPSHOTS=npa-snapshots
MINIO_SECURE=false

# Kafka (§8.2) — отключить только для локальной отладки без docker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# LLM (OpenAI-compatible). Пусто = механический fallback из предъявленного текста
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen3-8b

GATEWAY_API_BASE=
GATEWAY_API_KEY=
GATEWAY_MODEL=gpt-4o-mini

# Алерты наблюдаемости (§11). Пусто = только логи/health
COLLECT_SILENT_ALERT_HOURS=36
ALERT_WEBHOOK_URL=

# OCR на сканах: очень медленно (~секунды на страницу). Для массового process — false
OCR_ENABLED=false
# Для OCR также нужны: brew install poppler tesseract tessdata (rus)
PRAVO_API_BASE_URL=http://publication.pravo.gov.ru
PRAVO_BLOCK_PRESIDENT=president
# GUID вида «Федеральный закон» — получить через /api/DocumentTypes?block=president
PRAVO_DOCUMENT_TYPE_FZ_ID=82a8bf1c-3bc7-47ed-827f-7affd43a7f27
