# =============================================================================
# ExplainLaw — шаблон env
# Прод: скопируйте в .env и заполните блок «ПРОД (Yandex)» ниже.
# Локалка: оставьте localhost / MinIO или поднимите --profile local.
# =============================================================================

# --- База (локалка) ---
DATABASE_URL=postgresql+psycopg://explainlaw:explainlaw@localhost:5432/explainlaw
DATABASE_SSLMODE=prefer

# --- Object storage: локальный MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=explainlaw
MINIO_SECRET_KEY=explainlawsecret
MINIO_BUCKET_RAW=npa-raw
MINIO_BUCKET_SNAPSHOTS=npa-snapshots
MINIO_SECURE=false
MINIO_REGION=
MINIO_PREFIX=

# --- Kafka / LLM (локалка) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_PIPELINE_EVENTS=true
LLM_TRANSPORT=http
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen3-8b

GATEWAY_API_BASE=
GATEWAY_API_KEY=
GATEWAY_MODEL=gpt-4o-mini

# =============================================================================
# ПРОД (Yandex) — раскомментируйте и заполните; локальные MINIO_*/LLM http не нужны
# =============================================================================
# DATABASE_URL=postgresql+psycopg://USER:PASS@rc1b-XXXX.mdb.yandexcloud.net:6432/DB
# DATABASE_SSLMODE=require
#
# AWS_ENDPOINT_URL=https://storage.yandexcloud.net
# AWS_KEY_ID=
# AWS_SECRET_KEY=
# AWS_BUCKET=explain-npa
#
# KAFKA_BOOTSTRAP_SERVERS=rc1a-XXXX.mdb.yandexcloud.net:9091
# KAFKA_USERNAME=llm
# KAFKA_PASSWORD=
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# # CA уже в Docker-образе — НЕ указывайте хостовый путь:
# # KAFKA_SSL_CA_LOCATION=/usr/local/share/ca-certificates/Yandex/YandexInternalRootCA.crt
# KAFKA_PIPELINE_EVENTS=false
# LLM_TRANSPORT=kafka
# KAFKA_LLM_REQUESTS_TOPIC=llm.requests
# KAFKA_LLM_RESPONSES_TOPIC=llm.responses
# KAFKA_LLM_GROUP_ID=explainlaw-llm
# LLM_REQUEST_TIMEOUT=300
# QWEN_MODEL=qwen3:8b

# OCR: в Docker-образе есть tesseract(+rus). На проде обязательно true.
OCR_ENABLED=true
OCR_ENGINE=tesseract
OCR_TEXT_THRESHOLD=200
YANDEX_VISION_API_KEY=
YANDEX_VISION_IAM_TOKEN=

# Публикация / алерты
DIGEST_MIN_ITEMS=3
DIGEST_MAX_ITEMS=7
POST_RESERVE_COUNT=2
PUBLISH_EXPORT_DIR=/app/logs/published
COLLECT_SILENT_ALERT_HOURS=36
ALERT_WEBHOOK_URL=
ALERT_LOG_PATH=/app/logs/alerts.jsonl
ALERT_TELEGRAM_MAX_PER_DAY=1
ALERT_TELEGRAM_STATE_PATH=/app/logs/alert_telegram_state.json
# Утренний OK в Telegram даже без проблем (проверка канала каждый день)
ALERT_TELEGRAM_HEARTBEAT=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLISH=true
# TELEGRAM_API_BASE=https://api.telegram.org

GATE_LLM_VERIFY=true

# Pipeline limits — daily всегда с лимитом (в crontab default 50, если пусто)
PIPELINE_PROCESS_LIMIT=50
PIPELINE_FETCH_MISSING_LIMIT=3
PIPELINE_BACKFILL_LIMIT=500
PIPELINE_BACKFILL_PDF_LIMIT=
PIPELINE_SMOKE_PROCESS_LIMIT=5
COLLECT_PERIOD_TYPE=daily

# Cron (supercronic в контейнере cron)
TZ=Europe/Moscow
CRON_TIMEZONE=Europe/Moscow
CRON_DAILY_ENABLED=true
CRON_DAILY_SCHEDULE=0 8 * * *
CRON_WEEKLY_ENABLED=true
CRON_WEEKLY_SCHEDULE=0 9 * * 1
CRON_BACKFILL_ENABLED=true
CRON_BACKFILL_SCHEDULE=0 3 * * 0
CRON_HEALTH_ENABLED=true
CRON_HEALTH_SCHEDULE=30 8 * * *
# После первого деплоя можно один раз включить smoke, потом выключить:
CRON_RUN_ON_START=false
# CRON_RUN_ON_START=true
# CRON_RUN_ON_START_JOB=smoke
# daily | weekly | health | smoke

PRAVO_API_BASE_URL=http://publication.pravo.gov.ru
PRAVO_BLOCK_PRESIDENT=president
PRAVO_DOCUMENT_TYPE_FZ_ID=82a8bf1c-3bc7-47ed-827f-7affd43a7f27
PRAVO_CATALOG_FZ_TOTAL=7761
