# Static fallback crontab (prod uses docker/cron-entrypoint.sh → render from env).
# Defaults match CRON_*_SCHEDULE in .env.example.
# Daily pipeline
0 8 * * * /usr/local/bin/explainlaw daily
# Weekly digest → export + Telegram
0 9 * * 1 /usr/local/bin/explainlaw daily --weekly-publish
# Delta / PDF backfill
0 3 * * 0 /usr/local/bin/explainlaw rebuild-deltas --resume --limit 500
# Health + Telegram alerts (раз в сутки)
0 10 * * * /usr/local/bin/explainlaw health --alert
